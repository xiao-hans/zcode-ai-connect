{
  "name": "hermes-connect-services",
  "version": "1.3.4",
  "description": "Bring zcode-ai-connect's four loopback endpoints to hermes, and add the missing turn-end gate that re-runs a turn when the model announces a next step but calls no tool.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "xiao-hans",
    "url": "https://github.com/xiao-hans"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiao-hans/zcode-ai-connect.git",
    "directory": "hermes-connect-services"
  },
  "homepage": "https://github.com/xiao-hans/zcode-ai-connect/tree/main/hermes-connect-services#readme",
  "bugs": {
    "url": "https://github.com/xiao-hans/zcode-ai-connect/issues"
  },
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "files": [
    "bin",
    "src",
    "lib",
    "tests",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "hermes-connect-ensure": "bin/ensure-services.mjs",
    "hermes-connect-sync": "bin/sync-hermes-config.mjs",
    "hermes-connect-stall-gate": "bin/patch-hermes-stall-gate.mjs"
  },
  "dependencies": {
    "zcode-qoder-connect": "^1.2.4",
    "zcode-qwenwork-connect": "^1.2.4",
    "zcode-trae-connect": "^1.2.4",
    "zcode-workbuddy-connect": "^1.2.4"
  },
  "keywords": [
    "hermes",
    "openai-compatible",
