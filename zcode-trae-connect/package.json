{
  "name": "zcode-trae-connect",
  "version": "1.0.0",
  "private": true,
  "description": "Expose Trae desktop-app models (CN and international) through a loopback OpenAI-compatible endpoint, for use as a model provider in ZCode or any OpenAI-compatible client.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18.17.0"
  },
  "bin": {
    "zcode-trae-connect": "./bin/cli.mjs"
  },
  "exports": {
    ".": "./src/upstream.js",
    "./server": "./src/server.js",
    "./credentials": "./src/credentials.js",
    "./catalog": "./src/catalog.js"
  },
  "scripts": {
    "serve": "node bin/cli.mjs serve",
    "status": "node bin/cli.mjs status",
    "doctor": "node bin/cli.mjs doctor",
    "test": "node --test \"tests/*.test.js\""
  },
  "dependencies": {},
  "keywords": [
    "trae",
    "openai-compatible",
    "provider",
    "zcode"
  ]
}
