{
  "name": "zcode-trae-connect",
  "version": "1.2.4",
  "description": "Expose Trae desktop-app models (CN and international) through a loopback OpenAI-compatible endpoint, for use as a model provider in ZCode or any OpenAI-compatible client.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "xiao-hans"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiao-hans/zcode-ai-connect.git",
    "directory": "zcode-trae-connect"
  },
  "homepage": "https://github.com/xiao-hans/zcode-ai-connect/tree/main/zcode-trae-connect#readme",
  "bugs": {
    "url": "https://github.com/xiao-hans/zcode-ai-connect/issues"
  },
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "bin": {
    "zcode-trae-connect": "bin/cli.mjs"
  },
  "files": [
    ".zcode-plugin",
    "bin",
    "src",
    "!src/*.bak-order",
    "hooks",
    "skills",
    "docs",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/upstream.js",
    "./server": "./src/server.js",
    "./credentials": "./src/credentials.js",
    "./catalog": "./src/catalog.js"
  },
  "scripts": {
    "serve": "node bin/cli.mjs serve",
    "status": "node bin/cli.mjs status",
    "doctor": "node bin/cli.mjs doctor",
    "test": "node --test \"tests/*.test.js\""
  },
  "dependencies": {},
  "keywords": [
    "trae",
    "openai-compatible",
    "provider",
    "zcode"
  ]
}
